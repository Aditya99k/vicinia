{
  "title": "Kafka Consumer Lag",
  "uid": "vicinia-kafka-lag",
  "tags": ["vicinia", "infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumer lag by service and topic",
      "description": "kafka_consumer_fetch_manager_records_lag — auto-registered by Spring Boot's Kafka+Micrometer integration for every @KafkaListener consumer, no application code needed. Includes retry/DLT topics, so a growing lag on a *-retry or *-dlt topic is its own early signal (ARCHITECTURE.md §9's DLQ pattern).",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kafka_consumer_fetch_manager_records_lag",
          "legendFormat": "{{application}} / {{topic}} / p{{partition}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Current lag (table)",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kafka_consumer_fetch_manager_records_lag",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    }
  ]
}
