<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vicinia</groupId>
        <artifactId>vicinia-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common</artifactId>
    <packaging>jar</packaging>
    <name>common</name>
    <description>
        Shared code reused by every domain service: JWT issuing/parsing
        (ARCHITECTURE.md §14) and the internal-request filter that enforces
        gateway-only access (ADR 0008). No web stack is assumed here — the
        internal-request filter is servlet-based (for the MVC domain
        services); api-gateway, being WebFlux, uses only the JWT classes.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <!-- Stage 16: every service that depends on common gets a
                 /actuator/prometheus endpoint for free the moment it also
                 has spring-boot-starter-actuator (which all of them
                 already do) — one dependency here instead of touching 14
                 services' own poms individually. -->
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <!-- Needed for CorrelationIdRecordInterceptor's Spring Kafka
                 types (RecordInterceptor, ContainerCustomizer). Pulls
                 kafka-clients (needed for CorrelationIdProducerInterceptor
                 too) transitively. review-service is the one
                 common-dependent service with no Kafka usage of its own —
                 an unused transitive dependency there is a small,
                 acceptable cost against duplicating both interceptor
                 classes into every one of the 13 services that do use
                 Kafka. -->
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
    </dependencies>
</project>
