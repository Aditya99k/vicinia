# Copy to .env — usually nothing to fill in.
#
# VITE_API_BASE_URL is optional. Left unset (the default), the app derives
# the gateway URL from whatever host the browser used to load this page —
# localhost on a PC, a LAN IP or .local hostname on a phone — so it keeps
# working across Wi-Fi/network changes without editing this file. Only
# set it to force a specific API host.
# VITE_API_BASE_URL=http://localhost:8080
