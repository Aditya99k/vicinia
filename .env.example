# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — it must never be committed. This file (.env.example)
# is the one that's committed, so anyone cloning the repo knows exactly
# what variables are needed, without ever seeing a real secret value.
#
# start-infra.sh loads .env automatically (and refuses to start without one).
# docker-compose.infra.yml also reads .env automatically — Compose does
# this natively for any .env file sitting next to it.

# --- Postgres bootstrap credentials -----------------------------------
# Local dev only — see DEPLOYMENT.md for why this is fine at this stage
# and what changes for a real deployment.
POSTGRES_USER=vicinia
POSTGRES_PASSWORD=vicinia
POSTGRES_DB=vicinia

# --- Shared internal-request secret (ADR 0008) -------------------------
# Every domain service's InternalRequestFilter checks incoming requests
# against this value; api-gateway stamps it onto every request it
# proxies. A request that skips the gateway won't carry it and gets
# rejected (403). Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VICINIA_INTERNAL_SECRET=

# --- JWT signing key (ARCHITECTURE.md §14) ------------------------------
# HS256 needs at least 32 bytes. Shared by auth-service (issues access
# tokens) and api-gateway (verifies them) — they must be byte-for-byte
# identical or nothing will ever validate. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VICINIA_JWT_SECRET=
