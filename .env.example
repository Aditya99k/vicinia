# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — it must never be committed. This file (.env.example)
# is the one that's committed, so anyone cloning the repo knows exactly
# what variables are needed, without ever seeing a real secret value.
#
# start-infra.sh loads .env automatically (and refuses to start without one).
# docker-compose.infra.yml also reads .env automatically — Compose does
# this natively for any .env file sitting next to it.

# --- Postgres bootstrap credentials -----------------------------------
# Local dev only — see DEPLOYMENT.md for why this is fine at this stage
# and what changes for a real deployment.
POSTGRES_USER=vicinia
POSTGRES_PASSWORD=vicinia
POSTGRES_DB=vicinia

# --- Shared internal-request secret (ADR 0008) -------------------------
# Every domain service's InternalRequestFilter checks incoming requests
# against this value; api-gateway stamps it onto every request it
# proxies. A request that skips the gateway won't carry it and gets
# rejected (403). Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VICINIA_INTERNAL_SECRET=

# --- JWT signing key (ARCHITECTURE.md §14) ------------------------------
# HS256 needs at least 32 bytes. Shared by auth-service (issues access
# tokens) and api-gateway (verifies them) — they must be byte-for-byte
# identical or nothing will ever validate. Generate a fresh one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VICINIA_JWT_SECRET=

# --- MongoDB connection (catalog-service, Stage 4+) ---------------------
# Optional — defaults to the self-hosted local container in
# docker-compose.infra.yml if unset. Only set this to point at a real
# MongoDB Atlas cluster instead (see docker-compose.infra.yml's comment
# on the mongo service for why local dev doesn't need Atlas yet).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/catalog_db

# --- Razorpay (payment-service, Stage 9) ---------------------------------
# Test-mode keys from https://dashboard.razorpay.com (free signup, cannot
# move real money). RAZORPAY_KEY_ID/SECRET authenticate our server-to-server
# order-creation calls to Razorpay's API. RAZORPAY_WEBHOOK_SECRET verifies
# the HMAC-SHA256 signature on incoming webhook calls (ARCHITECTURE.md §4.6)
# — in a real deployment this is the value Razorpay's dashboard generates
# when you register a real webhook URL; locally, with no public HTTPS
# endpoint to register, generate your own and use it to construct/verify
# test payloads yourself:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (catalog-service, Stage 18) ------------------------------
# Free-tier signup at https://cloudinary.com — merchant product-image
# uploads go straight from the browser to Cloudinary using a signature
# catalog-service mints (CloudinaryService), never proxying image bytes
# through our own servers. All three values come from your Cloudinary
# dashboard's "API Environment variable" / account details page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
